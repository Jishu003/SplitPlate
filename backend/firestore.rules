rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──────────────────────────────────────
    // Each user document keyed by emailKey (jishu_at_gmail_com)
    match /users/{userId} {
      allow read, write: if true;

      // Orders subcollection — nested under each user
      match /orders/{orderId} {
        allow read, write: if true;
      }
    }

    // ── Legacy root orders (will be auto-cleaned on login) ────
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // ── Ping test (used to verify Firestore connectivity) ─────
    match /_ping/{doc} {
      allow read, write: if true;
    }
  }
}
